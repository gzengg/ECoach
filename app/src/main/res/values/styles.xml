<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      v2.0 AppTheme — 基于 AOSP 框架自带的 Theme.Material（不是 Material Components 库）。
      深色 + 自定义 colorAccent/colorPrimary，让光标、ProgressBar、PopupMenu 自动跟随配色。
    -->
    <style name="AppTheme" parent="@android:style/Theme.Material">
        <!-- 背景 -->
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:statusBarColor">@color/bg_base</item>
        <item name="android:navigationBarColor">@color/bg_base</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- 主题色 -->
        <item name="android:colorPrimary">@color/bg_base</item>
        <item name="android:colorPrimaryDark">@color/bg_base</item>
        <item name="android:colorAccent">@color/accent_solid</item>
        <!-- 文字 -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <!-- 按钮：用 @color/accent_on 直接引用，避免 theme 循环 -->
        <item name="android:buttonStyle">@style/AppBtnPrimary</item>
        <item name="android:editTextStyle">@style/AppInput</item>
    </style>

    <!-- 主 CTA 胶囊：渐变 + 深色文字（深色文字保证对比度） -->
    <style name="AppBtnPrimary" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/pill_primary</item>
        <item name="android:textColor">@color/accent_on</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingLeft">28dp</item>
        <item name="android:paddingRight">28dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/height_cta</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- 次按钮：透明 + 白描边 + 白文字 -->
    <style name="AppBtnSecondary" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/height_row</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- 文字按钮：纯透明 -->
    <style name="AppBtnText" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/btn_text</item>
        <item name="android:textColor">@color/accent_solid</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- 输入框 -->
    <style name="AppInput" parent="@android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">@dimen/height_input</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>

    <!--
      设置页统一样式。
      历史教训：旧版每个输入框上方单独占一行标签，整页高达 746dp，
      而 ColorOS 上可用视口只有约 645dp，必须滚动；滚到底时最上面那行
      会被切成半截（看起来像乱码）。改成「标签在左、输入框在右」后
      整页约 570dp，一屏放得下，不再出现半截行。
    -->

    <!-- 一行：左侧标签 + 右侧控件 -->
    <style name="SettingRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>

    <style name="SettingLabel">
        <item name="android:layout_width">76dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- 单行输入框：跟随右侧剩余宽度 -->
    <style name="SettingInput">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:inputType">text</item>
    </style>

    <!-- 独占一行的多行输入框 -->
    <style name="SettingField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- 分组小标题 -->
    <style name="SettingHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- 加减按钮 -->
    <style name="SettingStepper">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">18sp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- 加减按钮中间显示的当前值 -->
    <style name="SettingValue">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!--
      模型 / 音色选择芯片与行内动作按钮（v4）。
      未选中用 bg_chip、选中用 pill_glass（与悬浮窗 Tab 同一套做法，由代码切换背景）。
    -->
    <style name="ModelChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">@dimen/height_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!--
      选择芯片（识别模型 / 朗读音色）：**不能复用 ModelChip**——
      它带 layout_weight=1，在子视图里覆盖不掉，多个芯片会被等分挤压、文字换行
      （真机截图：中文音色 5 个时「白桦」被压成两行）。这里用 wrap_content 自然宽度。
    -->
    <style name="PickChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_weight">0</item>
        <item name="android:layout_height">@dimen/height_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
    </style>

    <style name="ModelAction">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/height_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:layout_marginEnd">@dimen/space_sm</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/accent_solid</item>
    </style>

    <!--
      Bottom Sheet 窗口动画：只有入场（§4.5 只做进入动画），关闭时直接消失。
      遮罩与面板底色由 BottomSheetPanel 设置（scrim / bg_sheet）。
    -->
    <style name="SheetAnimation">
        <item name="android:windowEnterAnimation">@anim/sheet_enter</item>
    </style>

</resources>
