<?xml version="1.0" encoding="utf-8"?>
<!--
  取词卡片 v3.0：surface_1 底板 + 原文 + 译文 + 两个喇叭。
  ⚠️ 底板必须不透明（复用 bg_answer）。
  ⚠️ 对比度 ≥ 4.5:1。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_answer"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- 英文原文 -->
    <TextView
        android:id="@+id/tvGrabSource"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:lineSpacingExtra="2dp" />

    <!-- 中文译文 -->
    <TextView
        android:id="@+id/tvGrabTranslated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp" />

    <!-- 朗读按钮行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSpeakSrc"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="读原文"
            android:textColor="@color/accent_solid"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnSpeakDst"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="读译文"
            android:textColor="@color/accent_solid"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 状态/错误 -->
    <TextView
        android:id="@+id/tvGrabStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/warn"
        android:textSize="11sp"
        android:visibility="gone" />

</LinearLayout>
