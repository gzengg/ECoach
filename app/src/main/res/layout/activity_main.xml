<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面 v4.1「四 Tab 底部导航」：
  顶栏（标题 + 上下文动作）→ 内容区（4 个页面 View 显隐切换）→ 底部导航。

  页面职责（一页一件事）：
    pageListen   监听控制（状态 + CTA + 动态按钮）
    pageHistory  转录/取词历史（搜索 + 空状态 + 长按操作）
    pageModels   模型（在线：问答/识别/朗读三套接口 + 音色；离线：运行模式 + 模型列表；
                 下载源在顶栏 Bottom Sheet）
    pageSettings 系统提示词 / 悬浮窗外观（允许滚动，分组各自成块）

  视觉全部复用 Aurora Glass token；id 规则：既有 id 一律保留。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- ══════ 顶栏：标题 + 上下文动作（随页面显隐） ══════ -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvTopTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />

        <!-- 上下文动作：历史页=清空全部，模型页=下载源；其余页隐藏 -->
        <TextView
            android:id="@+id/btnTopAction"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:textSize="13sp"
            android:textColor="@color/danger"
            android:background="@drawable/btn_text"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ══════ 内容区 ══════ -->
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ── 页面 1：监听 ── -->
        <ScrollView
            android:id="@+id/pageListen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 状态卡片 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_surface"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <View
                        android:id="@+id/dotStatus"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/dot_idle" />

                    <!-- 状态文字（tvStatus，id 不可改） -->
                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>

                <!-- 未配置 API Key 时的引导提示（去「设置」Tab） -->
                <TextView
                    android:id="@+id/tvListenHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="12dp"
                    android:textSize="13sp"
                    android:textColor="@color/warn"
                    android:background="@drawable/btn_text"
                    android:text="@string/msg_no_api_key"
                    android:visibility="gone" />

                <!-- 主 CTA：开始监听 -->
                <Button
                    android:id="@+id/btnStart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/btn_start"
                    android:textColor="@color/accent_on"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- 停止：仅监听中显示 -->
                <Button
                    android:id="@+id/btnStop"
                    style="@style/AppBtnSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_stop"
                    android:visibility="gone" />

                <!-- 清空上下文：仅监听中显示 -->
                <Button
                    android:id="@+id/btnNewChat"
                    style="@style/AppBtnSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_new_chat"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <!-- ── 页面 2：历史 ── -->
        <LinearLayout
            android:id="@+id/pageHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/etHistorySearch"
                style="@style/AppInput"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:hint="@string/history_search_hint"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:maxLines="1" />

            <!-- 类型切换：转录 / 取词（沿用历史弹窗的计数文案） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/btnHistTranscript"
                    style="@style/ModelChip"
                    android:text="@string/history_tab_transcript" />
                <TextView android:id="@+id/btnHistGrab"
                    style="@style/ModelChip"
                    android:layout_marginEnd="0dp"
                    android:text="@string/history_tab_grab" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:id="@+id/historyList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>

                <!-- 空状态：首启无记录 / 搜索无结果（覆盖层，居中） -->
                <LinearLayout
                    android:id="@+id/historyEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="32dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvEmptyTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvEmptyMsg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/btnEmptyAction"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:paddingHorizontal="20dp"
                        android:layout_marginTop="16dp"
                        android:textSize="13sp"
                        android:textColor="@color/accent_solid"
                        android:background="@drawable/bg_chip"
                        android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- ── 页面 3：模型 ── -->
        <ScrollView
            android:id="@+id/pageModels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <!-- focusableInTouchMode：抢初始焦点，打开时不弹键盘、不自己滚走 -->
            <LinearLayout
                android:id="@+id/pageModelsRoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:focusable="true"
                android:focusableInTouchMode="true">

                <!-- 运行模式 + 占用 + 识别模型选择 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_surface"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_marginBottom="8dp">

                    <TextView style="@style/SettingHeader"
                        android:layout_marginTop="0dp"
                        android:text="@string/models_mode_title" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView android:id="@+id/btnModeAuto"
                            style="@style/ModelChip"
                            android:text="@string/models_mode_auto" />
                        <TextView android:id="@+id/btnModeOnline"
                            style="@style/ModelChip"
                            android:text="@string/models_mode_online" />
                        <TextView android:id="@+id/btnModeOffline"
                            style="@style/ModelChip"
                            android:text="@string/models_mode_offline" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="12sp"
                        android:textColor="@color/text_tertiary"
                        android:text="@string/models_mode_hint" />

                    <TextView
                        android:id="@+id/tvModelSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:text="@string/models_pick_asr" />
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginTop="4dp">
                        <LinearLayout android:id="@+id/asrModelChips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- ══ 在线模型：三套接口各自独立（问答 / 识别 / 朗读），可分别指向不同服务商 ══ -->

                <!-- 分组 A：问答模型 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_surface"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_marginBottom="8dp">

                    <TextView style="@style/SettingHeader" android:layout_marginTop="0dp"
                        android:text="@string/set_group_chat" />

                    <LinearLayout style="@style/SettingRow" android:layout_marginTop="0dp">
                        <TextView style="@style/SettingLabel"
                            android:text="@string/set_label_provider" />
                        <TextView android:id="@+id/btnProviderChat" style="@style/ModelAction"
                            android:text="@string/set_provider_pick" />
                    </LinearLayout>

                    <LinearLayout style="@style/SettingRow">
                        <TextView style="@style/SettingLabel"
                            android:text="@string/set_label_protocol" />
                        <HorizontalScrollView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="@dimen/height_chip"
                            android:scrollbars="none">
                            <LinearLayout android:id="@+id/chatProtocolChips"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>
                    </LinearLayout>

                    <LinearLayout style="@style/SettingRow">
                        <TextView style="@style/SettingLabel"
                            android:text="@string/set_label_endpoint"
                            android:labelFor="@id/etBaseUrl" />
                        <EditText android:id="@+id/etBaseUrl" style="@style/SettingInput"
                            android:inputType="textUri"
                            android:hint="@string/set_base_url_hint" />
                    </LinearLayout>

                    <LinearLayout style="@style/SettingRow">
                        <TextView style="@style/SettingLabel"
                            android:text="@string/set_label_key"
                            android:labelFor="@id/etApiKey" />
                        <EditText android:id="@+id/etApiKey" style="@style/SettingInput"
                            android:inputType="textPassword" />
                        <TextView android:id="@+id/btnToggleKey" style="@style/SettingTrailing"
                            android:text="@string/set_show_key" />
                    </LinearLayout>

                    <LinearLayout style="@style/SettingRow">
                        <TextView style="@style/SettingLabel"
                            android:text="@string/set_label_model"
                            android:labelFor="@id/etChatModel" />
                        <EditText android:id="@+id/etChatModel" style="@style/SettingInput" />
                        <TextView android:id="@+id/btnPickChat" style="@style/SettingTrailing"
                            android:text="@string/set_pick" />
                    </LinearLayout>

                    <TextView android:id="@+id/btnProbeChat" style="@style/ModelAction"
                        android:layout_marginTop="6dp"
                        android:text="@string/set_probe_this" />
                    <TextView android:id="@+id/tvProbeChat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="12sp"
                        android:textColor="@color/text_tertiary"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- 分组 B：识别模型（qwen-audio 系列走 DashScope，端点是完整 URL） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_surface"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_marginBottom="8dp">

                    <TextView style="@style/SettingHeader" android:layout_marginTop="0dp"
                        android:text="@string/set_group_asr" />

                    <LinearLayout style="@style/SettingRow" android:layout_marginTop="0dp">
                        <TextView style="@style/SettingLabel"
                            android:text="@string/set_label_provider" />
                        <TextView android:id="@+id/btnProviderAsr" style="@style/ModelAction"
                            android:text="@string/set_provider_pick" />
                    </LinearLayout>

                    <LinearLayout style="@style/SettingRow">
                        <TextView style="@style/SettingLabel"
                            android:text="@string/set_label_protocol" />
                        <HorizontalScrollView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="@dimen/height_chip"
                            android:scrollbars="none">
                            <LinearLayout android:id="@+id/asrProtocolChips"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>
                    </LinearLayout>

                    <LinearLayout style="@style/SettingRow">
                        <TextView style="@style/SettingLabel"
                            android:text="@string/set_label_endpoint"
                            android:labelFor="@id/etAsrBaseUrl" />
                        <EditText android:id="@+id/etAsrBaseUrl" style="@style/SettingInput"
                            android:inputType="textUri"
                            android:hint="@string/set_asr_url_hint" />
                    </LinearLayout>

                    <LinearLayout style="@style/SettingRow">
                        <TextView style="@style/SettingLabel"
                            android:text="@string/set_label_key"
                            android:labelFor="@id/etAsrKey" />
                        <EditText android:id="@+id/etAsrKey" style="@style/SettingInput"
                            android:inputType="textPassword"
                            android:hint="@string/set_key_follow_hint" />
                        <TextView android:id="@+id/btnToggleAsrKey" style="@style/SettingTrailing"
                            android:text="@string/set_show_key" />
                    </LinearLayout>

                    <LinearLayout style="@style/SettingRow">
                        <TextView style="@style/SettingLabel"
                            android:text="@string/set_label_model"
                            android:labelFor="@id/etAsrModel" />
                        <EditText android:id="@+id/etAsrModel" style="@style/SettingInput" />
                        <TextView android:id="@+id/btnPickAsr" style="@style/SettingTrailing"
                            android:text="@string/set_pick" />
                    </LinearLayout>

                    <TextView android:id="@+id/btnProbeAsr" style="@style/ModelAction"
                        android:layout_marginTop="6dp"
                        android:text="@string/set_probe_this" />
                    <TextView android:id="@+id/tvProbeAsr"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="12sp"
                        android:textColor="@color/text_tertiary"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- 分组 C：朗读模型（mimo TTS 走 OpenAI 兼容的 chat/completions） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_surface"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_marginBottom="8dp">

                    <TextView style="@style/SettingHeader" android:layout_marginTop="0dp"
                        android:text="@string/set_group_tts" />

                    <LinearLayout style="@style/SettingRow" android:layout_marginTop="0dp">
                        <TextView style="@style/SettingLabel"
                            android:text="@string/set_label_provider" />
                        <TextView android:id="@+id/btnProviderTts" style="@style/ModelAction"
                            android:text="@string/set_provider_pick" />
                    </LinearLayout>

                    <LinearLayout style="@style/SettingRow">
                        <TextView style="@style/SettingLabel"
                            android:text="@string/set_label_protocol" />
                        <HorizontalScrollView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="@dimen/height_chip"
                            android:scrollbars="none">
                            <LinearLayout android:id="@+id/ttsProtocolChips"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>
                    </LinearLayout>

                    <LinearLayout style="@style/SettingRow">
                        <TextView style="@style/SettingLabel"
                            android:text="@string/set_label_endpoint"
                            android:labelFor="@id/etTtsBaseUrl" />
                        <EditText android:id="@+id/etTtsBaseUrl" style="@style/SettingInput"
                            android:inputType="textUri"
                            android:hint="@string/set_base_url_hint" />
                    </LinearLayout>

                    <LinearLayout style="@style/SettingRow">
                        <TextView style="@style/SettingLabel"
                            android:text="@string/set_label_key"
                            android:labelFor="@id/etTtsKey" />
                        <EditText android:id="@+id/etTtsKey" style="@style/SettingInput"
                            android:inputType="textPassword"
                            android:hint="@string/set_key_follow_hint" />
                        <TextView android:id="@+id/btnToggleTtsKey" style="@style/SettingTrailing"
                            android:text="@string/set_show_key" />
                    </LinearLayout>

                    <LinearLayout style="@style/SettingRow">
                        <TextView style="@style/SettingLabel"
                            android:text="@string/set_label_model"
                            android:labelFor="@id/etTtsModel" />
                        <EditText android:id="@+id/etTtsModel" style="@style/SettingInput"
                            android:hint="mimo-v2.5-tts" />
                        <TextView android:id="@+id/btnPickTts" style="@style/SettingTrailing"
                            android:text="@string/set_pick" />
                    </LinearLayout>

                    <TextView android:id="@+id/btnProbeTts" style="@style/ModelAction"
                        android:layout_marginTop="6dp"
                        android:text="@string/set_probe_this" />
                    <TextView android:id="@+id/tvProbeTts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="12sp"
                        android:textColor="@color/text_tertiary"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- 分组 D：朗读音色（随 TTS 模型变：mimo / MiniMax / 豆包 / OpenAI 各一套声） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_surface"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_marginBottom="8dp">

                    <TextView style="@style/SettingHeader" android:layout_marginTop="0dp"
                        android:text="@string/set_tts_voice_hint" />

                    <!-- 音色行：点击弹选择 sheet；当前值由代码回填 -->
                    <FrameLayout
                        android:id="@+id/btnVoiceEn"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/card_row"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView style="@style/SettingLabel"
                            android:layout_gravity="center_vertical"
                            android:text="@string/set_tts_voice_en" />
                        <TextView android:id="@+id/tvVoiceEn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|end"
                            android:layout_marginEnd="12dp"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary" />
                    </FrameLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="16dp"
                        android:background="@color/stroke_soft" />

                    <FrameLayout
                        android:id="@+id/btnVoiceZh"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/card_row"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView style="@style/SettingLabel"
                            android:layout_gravity="center_vertical"
                            android:text="@string/set_tts_voice_zh" />
                        <TextView android:id="@+id/tvVoiceZh"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|end"
                            android:layout_marginEnd="12dp"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary" />
                    </FrameLayout>

                    <!-- 探测当前 TTS 模型的可选音色（mimo 这类会把可用音色回显在报错里） -->
                    <TextView android:id="@+id/btnDetectVoices" style="@style/ModelAction"
                        android:layout_marginTop="8dp"
                        android:text="@string/set_detect_voices" />
                </LinearLayout>

                <!-- 保存：在线接口的地址 / Key / 模型（协议与服务商点了就生效） -->
                <Button android:id="@+id/btnSaveModels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="15sp"
                    android:text="@string/set_save" />

                <!-- 模型列表（运行时动态填充） -->
                <LinearLayout
                    android:id="@+id/modelList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <!-- ── 页面 4：设置 ── -->
        <ScrollView
            android:id="@+id/pageSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fitsSystemWindows="true"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <!-- focusableInTouchMode：抢初始焦点，打开时不弹键盘、不自己滚走 -->
            <LinearLayout
                android:id="@+id/settingsRoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="4dp"
                android:focusable="true"
                android:focusableInTouchMode="true">

                <!-- 分组 1：系统提示词 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_surface"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_marginBottom="8dp">

                    <TextView android:id="@+id/etSysPromptLabel" style="@style/SettingHeader"
                        android:text="@string/set_sys_prompt"
                        android:labelFor="@id/etSysPrompt" />
                    <EditText android:id="@+id/etSysPrompt" style="@style/SettingField"
                        android:layout_height="96dp"
                        android:gravity="top|start"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:scrollbars="vertical" />
                </LinearLayout>

                <!-- 分组 2：悬浮窗外观 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_surface"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_marginBottom="8dp">

                    <TextView style="@style/SettingHeader"
                        android:text="@string/set_appearance" />

                    <LinearLayout style="@style/SettingRow">
                        <TextView style="@style/SettingLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/set_font_size" />
                        <TextView android:id="@+id/btnFontMinus" style="@style/SettingStepper"
                            android:text="-" />
                        <TextView android:id="@+id/tvFontValue" style="@style/SettingValue" />
                        <TextView android:id="@+id/btnFontPlus" style="@style/SettingStepper"
                            android:text="+" />
                    </LinearLayout>

                    <LinearLayout style="@style/SettingRow">
                        <TextView style="@style/SettingLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/set_width" />
                        <TextView android:id="@+id/btnWidthMinus" style="@style/SettingStepper"
                            android:text="-" />
                        <TextView android:id="@+id/tvWidthValue" style="@style/SettingValue" />
                        <TextView android:id="@+id/btnWidthPlus" style="@style/SettingStepper"
                            android:text="+" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 按钮 -->
                <Button android:id="@+id/btnSave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="15sp"
                    android:text="@string/set_save" />

                <Button android:id="@+id/btnReset"
                    style="@style/AppBtnSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="14sp"
                    android:text="@string/set_reset" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- ══════ 底部导航 ══════ -->
    <com.rd.englishcoach.BottomBar
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
