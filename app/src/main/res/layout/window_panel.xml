<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- 拖动栏 -->
    <LinearLayout
        android:id="@+id/dragBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">
        <TextView android:id="@+id/tvDot" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="●" android:textColor="#4CAF50" android:textSize="14sp" />
        <TextView android:id="@+id/tvStatus" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="6dp" android:text="已暂停" android:textColor="#FFFFFF" android:textSize="13sp" />
        <TextView android:id="@+id/btnFontMinus" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:background="@drawable/bg_chip"
            android:paddingHorizontal="8dp" android:paddingVertical="2dp" android:text="A−" android:textColor="#CCFFFFFF" android:textSize="12sp" />
        <TextView android:id="@+id/btnFontPlus" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="4dp" android:background="@drawable/bg_chip"
            android:paddingHorizontal="8dp" android:paddingVertical="2dp" android:text="A+" android:textColor="#CCFFFFFF" android:textSize="12sp" />
        <TextView android:id="@+id/btnClose" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:paddingHorizontal="6dp" android:text="✕" android:textColor="#CCFFFFFF" android:textSize="16sp" />
    </LinearLayout>

    <!-- 音量条 -->
    <ProgressBar android:id="@+id/levelBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp"
        android:layout_marginBottom="6dp" android:max="100" android:progress="0"
        android:progressBackgroundTint="#33FFFFFF" android:progressTint="#4CAF50" />

    <!-- 暂停/继续 按钮（整段上传，不再切句） -->
    <TextView android:id="@+id/btnPause"
        android:layout_width="match_parent" android:layout_height="40dp"
        android:layout_marginBottom="6dp" android:background="@drawable/bg_chip"
        android:gravity="center" android:text="▶ 继续" android:textColor="#FFFFFF" android:textSize="15sp" />

    <!-- 重新授权（默认隐藏） -->
    <TextView android:id="@+id/btnReconsent"
        android:layout_width="match_parent" android:layout_height="36dp"
        android:layout_marginBottom="6dp" android:background="@drawable/bg_chip"
        android:gravity="center" android:text="重新授权" android:textColor="#FF9800" android:textSize="14sp"
        android:visibility="gone" />

    <!-- 状态/错误信息 -->
    <TextView android:id="@+id/tvMessage"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:maxLines="2" android:ellipsize="end" android:textColor="#FF9800" android:textSize="11sp"
        android:visibility="gone" />

    <!-- 轮次列表（原文 + 答案 + 按钮） -->
    <com.rd.englishcoach.MaxHeightScrollView android:id="@+id/scrollTurns"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:visibility="gone">
        <LinearLayout android:id="@+id/turnList"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
    </com.rd.englishcoach.MaxHeightScrollView>

    <!-- 内嵌提问输入框（默认隐藏，点击「询问AI」时展开） -->
    <LinearLayout android:id="@+id/inputRow"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">
        <EditText android:id="@+id/etQuestion"
            android:layout_width="0dp" android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:hint="输入问题…"
            android:inputType="text"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#80FFFFFF"
            android:textSize="13sp"
            android:singleLine="true"
            android:paddingHorizontal="10dp" />
        <TextView android:id="@+id/btnSendQuestion"
            android:layout_width="wrap_content" android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="发送"
            android:textColor="#4CAF50"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
