<?xml version="1.0" encoding="utf-8"?>
<!--
  悬浮窗面板 v3.1「深空玻璃」双 Tab 版：
  外层半透明玻璃 + 圆角 + 描边（bg_panel）
  dragBar 留在 Tab 外面（拖动栏在哪个页签都要能拖）
  公共区（两个 Tab 共享，保证主按钮 Y 位置一致）：
    levelBar（音量条）/ btnReconsent / tvMessage / primaryBar（继续 | 取词）
  听力页 = scrollTurns / inputRow
  取词页 = tvGrabStatus / scrollGrabs
  所有 id 保持不变，新增 id 以 btnTab*/tab*/primaryBar 为前缀。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:padding="@dimen/space_sm">

    <!-- 拖动栏（始终可见，留在 Tab 外面） -->
    <LinearLayout
        android:id="@+id/dragBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <View
            android:id="@+id/tvDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_idle" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="已暂停"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/btnFontMinus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="A−"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnFontPlus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="A+"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_text"
            android:paddingHorizontal="6dp"
            android:text="✕"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Tab 栏：听力 / 取词 -->
    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_chip"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnTabListen"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:text="听力"
            android:textColor="@color/accent_solid"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/btnTabGrab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:text="取词"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- 音量指示条：放在公共区（两个 Tab 都有）→ 保证两个 Tab 的主按钮 Y 位置一致 -->
    <ProgressBar
        android:id="@+id/levelBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginBottom="6dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/level_bar" />

    <!-- ═══ 公共提示区（两个 Tab 都要能看到） ═══
         此前 tvMessage / btnReconsent 放在 tabListening 内部，切到「取词」页后
         任何失败提示都不可见 → 用户看到的是「点取词完全没反应」。 -->
    <TextView
        android:id="@+id/btnReconsent"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_chip"
        android:gravity="center"
        android:text="重新授权"
        android:textColor="@color/warn"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:textColor="@color/warn"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- ═══ 公共主按钮区 ═══
         两个 Tab 的主按钮（继续 / 取词）放在同一个容器里，只切可见性，
         结构上保证位置与尺寸完全一致（此前「继续」被 levelBar 往下顶了）。 -->
    <FrameLayout
        android:id="@+id/primaryBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/btnPause"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_cta_sm"
            android:background="@drawable/pill_glass"
            android:gravity="center"
            android:text="继续"
            android:textColor="@color/accent_solid"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/btnGrabStart"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_cta_sm"
            android:background="@drawable/pill_glass"
            android:gravity="center"
            android:text="开始取词"
            android:textColor="@color/accent_solid"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ═══ 听力页（现有内容） ═══ -->
    <LinearLayout
        android:id="@+id/tabListening"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.rd.englishcoach.MaxHeightScrollView
            android:id="@+id/scrollTurns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/turnList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </com.rd.englishcoach.MaxHeightScrollView>

        <LinearLayout
            android:id="@+id/inputRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">
            <EditText
                android:id="@+id/etQuestion"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:hint="输入问题…"
                android:inputType="text"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="13sp"
                android:singleLine="true"
                android:paddingHorizontal="10dp" />
            <TextView
                android:id="@+id/btnSendQuestion"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="发送"
                android:textColor="@color/accent_solid"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ 取词页（新增，默认隐藏） ═══ -->
    <LinearLayout
        android:id="@+id/tabGrab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvGrabStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:visibility="gone" />

        <com.rd.englishcoach.MaxHeightScrollView
            android:id="@+id/scrollGrabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/grabList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </com.rd.englishcoach.MaxHeightScrollView>
    </LinearLayout>

</LinearLayout>
