<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="API 设置" android:textSize="16sp" android:textStyle="bold" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Base URL" android:layout_marginTop="12dp" android:textSize="13sp" />
        <EditText android:id="@+id/etBaseUrl" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:singleLine="true" android:textSize="14sp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="API Key" android:layout_marginTop="8dp" android:textSize="13sp" />
        <EditText android:id="@+id/etApiKey" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:singleLine="true" android:textSize="14sp"
            android:inputType="textPassword" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="ASR 模型" android:layout_marginTop="8dp" android:textSize="13sp" />
        <EditText android:id="@+id/etAsrModel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:singleLine="true" android:textSize="14sp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="回答模型" android:layout_marginTop="8dp" android:textSize="13sp" />
        <EditText android:id="@+id/etChatModel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:singleLine="true" android:textSize="14sp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="系统提示词（告诉 AI 怎么回答）" android:layout_marginTop="8dp" android:textSize="13sp" />
        <EditText android:id="@+id/etSysPrompt" android:layout_width="match_parent"
            android:layout_height="120dp" android:gravity="top" android:textSize="13sp"
            android:inputType="textMultiLine" />

        <!-- 字号 / 宽度 / 显示原文 -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="悬浮窗外观" android:layout_marginTop="20dp" android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="10dp"
            android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="字号" android:textSize="14sp" />
            <TextView android:id="@+id/btnFontMinus" android:layout_width="40dp"
                android:layout_height="36dp" android:gravity="center" android:text="−"
                android:textSize="18sp" android:background="@drawable/bg_chip" />
            <TextView android:id="@+id/tvFontValue" android:layout_width="60dp"
                android:layout_height="wrap_content" android:gravity="center" android:text="15sp"
                android:textSize="14sp" />
            <TextView android:id="@+id/btnFontPlus" android:layout_width="40dp"
                android:layout_height="36dp" android:gravity="center" android:text="+"
                android:textSize="18sp" android:background="@drawable/bg_chip" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp"
            android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="窗口宽度" android:textSize="14sp" />
            <TextView android:id="@+id/btnWidthMinus" android:layout_width="40dp"
                android:layout_height="36dp" android:gravity="center" android:text="−"
                android:textSize="18sp" android:background="@drawable/bg_chip" />
            <TextView android:id="@+id/tvWidthValue" android:layout_width="60dp"
                android:layout_height="wrap_content" android:gravity="center" android:text="300dp"
                android:textSize="14sp" />
            <TextView android:id="@+id/btnWidthPlus" android:layout_width="40dp"
                android:layout_height="36dp" android:gravity="center" android:text="+"
                android:textSize="18sp" android:background="@drawable/bg_chip" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp"
            android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="显示识别原文" android:textSize="14sp" />
            <TextView android:id="@+id/btnShowTranscript" android:layout_width="60dp"
                android:layout_height="36dp" android:gravity="center" android:text="切换"
                android:textSize="13sp" android:background="@drawable/bg_chip" />
            <TextView android:id="@+id/tvShowTranscriptValue" android:layout_width="40dp"
                android:layout_height="wrap_content" android:gravity="center" android:text="关"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 按钮 -->
        <Button android:id="@+id/btnSave" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:text="保存并返回" android:textSize="16sp" />

        <Button android:id="@+id/btnReset" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="恢复默认值" android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
