<?xml version="1.0" encoding="utf-8"?>
<!--
  轮次卡片 v2.0：surface_1 底板 + caption 强调色 + chip 按钮。
  ⚠️ 底板必须不透明（SegmentCardLayoutTest 断言 alpha==0xFF）。
  ⚠️ 对比度 ≥ 4.5:1（SegmentCardLayoutTest 会算）。
  ⚠️ transcript 必须在 answer 之前、font >= answer。
  ⚠️ view id 一律不许改名。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_answer"
    android:orientation="horizontal">

    <!-- 左侧 accent 竖条：区分轮次卡片（青→靛渐变，与应用内 CTA 同族） -->
    <View
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:layout_marginVertical="10dp"
        android:background="@drawable/bar_accent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="10dp">

    <!-- 英文原文（优先显示，始终可见） -->
    <TextView
        android:id="@+id/tvTranscriptText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:lineSpacingExtra="2dp" />

    <!-- 参考回答区（默认隐藏） -->
    <TextView
        android:id="@+id/tvAnswerLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="AI 回答"
        android:textColor="@color/accent_solid"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.05"
        android:visibility="gone" />
    <TextView
        android:id="@+id/tvAnswerText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:lineSpacingExtra="2dp"
        android:visibility="gone" />

    <!-- 操作按钮行：看参考回答 + 询问AI -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/btnAskAnswer"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="💬 参考回答"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/btnAskQuestion"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="❓ 询问AI"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/btnSpeakTranscript"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="读原文"
            android:textColor="@color/accent_solid"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/btnSpeakAnswer"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="读回答"
            android:textColor="@color/accent_solid"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 加载中 / 错误 -->
    <TextView
        android:id="@+id/tvAnswerStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/warn"
        android:textSize="11sp"
        android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
