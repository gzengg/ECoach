<?xml version="1.0" encoding="utf-8"?>
<!-- 输入框：surface_2 填充 + 圆角 + 聚焦时高亮描边 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_2" />
            <stroke android:width="1dp" android:color="@color/stroke_strong" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_2" />
            <stroke android:width="1dp" android:color="@color/stroke_soft" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>
</selector>
