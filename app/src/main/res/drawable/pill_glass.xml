<?xml version="1.0" encoding="utf-8"?>
<!--
  悬浮窗主按钮：半透明流光胶囊（v3.1，用户要求「小一点 + 简单半透明流光」）。
  复用 accent token，但用低透明度让面板玻璃透出来；渐变首段带一道白色高光，
  形成斜向流光感。文字用 text_primary（白）——深色半透明底上对比度最高。
  ⚠️ 主界面主 CTA 仍用 pill_primary（亮渐变 + accent_on 深字，AGENTS §11.2）。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="#59FFFFFF"
        android:centerColor="#4D22D3EE"
        android:endColor="#336D8CF5" />
    <corners android:radius="@dimen/radius_pill" />
    <stroke
        android:width="1dp"
        android:color="#663DD9E8" />
</shape>
